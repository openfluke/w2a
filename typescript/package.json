{
  "name": "@openfluke/welvet",
  "version": "1.1.1",
  "description": "Welvet 1.1.1 AI Engine — WASM/TS bindings: layers, dtypes, cameral TrainModes, seed/fountain/helpers/memory, weights ApplySGD, DNA, Lucy",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "welvet",
    "cameral",
    "tanhi",
    "train-modes",
    "neural-network",
    "machine-learning",
    "webassembly",
    "wasm",
    "webgpu",
    "typescript",
    "javascript",
    "bun",
    "browser",
    "nodejs",
    "isomorphic",
    "entity",
    "quantization",
    "dna",
    "neat"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openfluke/welvet.git",
    "directory": "apps/w2a/typescript"
  },
  "bugs": {
    "url": "https://github.com/openfluke/welvet/issues"
  },
  "homepage": "https://github.com/openfluke/welvet/tree/main/apps/w2a/typescript#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "build:wasm": "bash ../wasm/build.sh",
    "build:all": "npm run build:wasm && npm run build",
    "postbuild": "shx cp -r assets/* dist/ && shx mkdir -p dist/tests && shx cp -r tests/* dist/tests/ && shx cp ../wasm/*.html dist/ 2>/dev/null || true && shx cp examples/browser.html dist/browser.html 2>/dev/null || true",
    "serve": "go run ../wasm/server/serve.go dist",
    "example": "tsx examples/run-example-smoke.ts",
    "test": "tsx tests/smoke.ts && tsx tests/coverage.ts && tsx tests/layers.ts && tsx tests/cameral.ts && tsx tests/systems.ts && tsx tests/test_all.ts --quick",
    "test:smoke": "tsx tests/smoke.ts",
    "test:consumer": "tsx examples/consumer_demo.ts",
    "test:coverage": "tsx tests/coverage.ts",
    "test:layers": "tsx tests/layers.ts",
    "test:cameral": "tsx tests/cameral.ts",
    "test:systems": "tsx tests/systems.ts",
    "test:bun": "bun tests/smoke.ts && bun tests/test_all.ts --quick",
    "test:bun:mega": "bun tests/test_all.ts --mega",
    "test:all": "tsx tests/test_all.ts --mega",
    "test:all:quick": "tsx tests/test_all.ts --quick",
    "test:all:mid": "tsx tests/test_all.ts --full",
    "test:matrix": "tsx tests/test_all.ts --mega",
    "pack:check": "npm run build:all && npm pack --dry-run",
    "publish:dry": "bash publish.sh --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4"
  }
}
